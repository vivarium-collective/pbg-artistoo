.venv/
__pycache__/
*.egg-info/
dist/
build/
*.pyc
.pytest_cache/
demo/*.png
output/
*.nc
.idea/
node_probe/
node_modules/
package-lock.json

# Everything under .pbg/ is generated EXCEPT the scaffolded schema files and
# hpc.env.example, which are authored content. Use `.pbg/*` (not `.pbg/`) so the
# re-includes below can rescue them — gitignore can't re-include children of a
# fully-ignored directory.
.pbg/*
!.pbg/schemas/
!.pbg/hpc.env.example
investigations/*/runs.db
investigations/*/viz/
investigations/*/.run.lock
workspace/reports/assets/*
!workspace/reports/assets/.keep
.superpowers/brainstorm/
